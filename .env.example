# =========================================================
# 复制本文件为 .env 后填写（.env 不会被提交到 git）
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# =========================================================

# ---- Qwen（阿里云百炼）----
# 1. 注册并登录：https://bailian.console.aliyun.com
# 2. 获取 API-KEY：控制台右上角头像 → API-KEY 管理 → 创建我的 API-KEY
# 3. 填入下方（sk- 开头）
QWEN_API_KEY=

# Qwen OpenAI 兼容接口地址（一般不用改）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择（可在百炼控制台「模型广场」查看可用列表）：
#   qwen-plus  推荐，速度/成本/能力均衡
#   qwen-turbo 更快更便宜，适合简单任务
#   qwen-max   更强，适合复杂推理
QWEN_MODEL=qwen-plus

# 模型自带联网搜索（enable_search）：True 时模型遇到实时/资料类问题会自动联网查证
# （官方参数，无需额外 Key；费用以百炼联网搜索计费为准）
QWEN_ENABLE_SEARCH=true

# 代码执行授权策略（让 Agent 能"写程序并运行"）：
#   off  完全禁用
#   auto 低风险自动执行，删除/格式化/关机等高风险自动拦截
#   ask  每次执行前在终端弹窗，由你输入 y/n 确认（默认，最安全）
AGENT_CODE_EXEC=ask

# ---- LLM 请求参数 ----
QWEN_TEMPERATURE=0.3
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3

# ---- Agent 循环 ----
AGENT_MAX_TURNS=12

# 对话上下文预算（token），超出后自动裁剪最老的对话。
# 默认 100000（100k）。qwen-plus 上下文上限 1M，100k 完全在模型能力内；
# 注意不要超过所选模型的上下文上限。
AGENT_CONTEXT_TOKENS=100000

# ---- 本地工具 ----
# 文件类工具的沙箱目录（相对项目根，可改）
AGENT_WORK_DIR=workspace
