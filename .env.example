# 复制为 .env 后填写；.env 被 Git 忽略，禁止提交真实 Key。
# ---- 默认：Z.ai Anthropic Messages ----
LLM_PROVIDER=zai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-5.3-flash
# 包含思考与回答的输出预算，避免因预算过小只返回 thinking。
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90
LLM_MAX_RETRIES=1

# ---- 兼容旧 Qwen / OpenAI 风格接口（LLM_PROVIDER=qwen） ----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.3
QWEN_ENABLE_SEARCH=true
QWEN_VISION_MODEL=qwen-vl-plus

# ---- 语音：auto 有 Qwen Key 则使用百炼原生 ASR/TTS ----
MEDIA_PROVIDER=auto
# auto/qwen 时自动复用 QWEN_API_KEY，不会复用 ZAI_API_KEY。
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
# MEDIA_PROVIDER=openai 时使用以下 OpenAI-compatible Audio API：
MEDIA_API_KEY=
MEDIA_BASE_URL=https://api.openai.com/v1
MEDIA_TRANSCRIBE_MODEL=whisper-1
MEDIA_TTS_MODEL=tts-1
MEDIA_VOICE=
MEDIA_TIMEOUT=120
# 视频分析需在本机安装 ffmpeg / ffprobe。

# ---- 可选：独立 Embedding 服务用于知识库 ----
# Anthropic Messages 不提供 embeddings，不能把 Z.ai 聊天 Key 发给百炼。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---- Agent 与本地工具 ----
AGENT_MAX_TURNS=12
AGENT_CONTEXT_TOKENS=100000
AGENT_WORK_DIR=workspace
AGENT_CODE_EXEC=ask
